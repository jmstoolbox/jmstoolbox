Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: JMSToolBox REST plugin
Bundle-SymbolicName: org.titou10.jtb.rest;singleton:=true
Automatic-Module-Name: org.titou10.jtb.rest
Bundle-Version: 8.3.0.qualifier
Bundle-ClassPath: .,
 lib/jakarta.ws.rs-api.jar,
 lib/jetty-server.jar,
 lib/jetty-util.jar,
 lib/jetty-security.jar,
 lib/jetty-ee10-servlet.jar,
 lib/jetty-io.jar,
 lib/jetty-http.jar,
 lib/jetty-session.jar,
 lib/jboss-logging.jar,
 lib/reactive-streams.jar,
 lib/json-patch.jar,
 lib/jackson-annotations.jar,
 lib/jackson-core.jar,
 lib/jackson-databind.jar,
 lib/jackson-jakarta-rs-base.jar,
 lib/jackson-jakarta-rs-json-provider.jar,
 lib/jackson-module-jakarta-xmlbind-annotations.jar,
 lib/resteasy-client.jar,
 lib/resteasy-core.jar,
 lib/resteasy-core-spi.jar,
 lib/resteasy-jackson2-provider.jar,
 lib/resteasy-jaxb-provider.jar
Bundle-Vendor: Denis Forveille
Require-Bundle: org.titou10.jtb.core,
 org.eclipse.e4.core.contexts,
 org.eclipse.e4.core.di,
 org.eclipse.core.runtime,
 org.eclipse.e4.core.services,
 org.eclipse.e4.ui.di,
 org.eclipse.e4.ui.model.workbench,
 org.eclipse.jface,
 slf4j.api,
 jakarta.servlet-api;bundle-version="6.0.0",
 jakarta.activation-api;bundle-version="2.1.2",
 jakarta.xml.bind-api;bundle-version="4.0.1"
Bundle-RequiredExecutionEnvironment: JavaSE-25
Import-Package: jakarta.annotation;version="2.1.1",
 jakarta.inject;version="2.0.1",
 org.titou10.jtb.connector,
 org.titou10.jtb.connector.transport
