Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Vendor: Denis Forveille
Bundle-Name: Apache Active MQ Artemis v1.x
Bundle-SymbolicName: org.titou10.jtb.qm.artemis;singleton:=true
Automatic-Module-Name: org.titou10.jtb.qm.artemis
Bundle-Version: 8.3.0.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-25
Eclipse-BuddyPolicy: registered
Import-Package: javax.jms,
