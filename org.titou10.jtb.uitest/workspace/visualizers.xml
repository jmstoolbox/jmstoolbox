<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Copied into the workspace of the UI tests. The script runs in GraalJS; its output goes to the "Script logs" dialog -->
<visualizers>
    <visualizer name="SWTBot visualizer" system="false">
        <kind>INLINE_SCRIPT</kind>
        <targetMsgType>TEXT</targetMsgType>
        <language>JavaScript</language>
        <showScriptLogs>true</showScriptLogs>
        <source>print("SWTBOT:" + jtb_payloadText.toUpperCase());</source>
    </visualizer>
</visualizers>
