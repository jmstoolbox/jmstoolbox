 lib/nativeimage.jar,
 lib/polyglot.jar,
 lib/regex.jar,
 lib/truffle-api.jar,
 lib/truffle-compiler.jar,
 lib/truffle-runtime.jar,
 lib/word.jar,
 lib/xz.jar
Bundle-Vendor: Denis Forveille
Export-Package: javax.jms,
  org.titou10.jtb.config.gen,
  org.titou10.jtb.connector,
  org.titou10.jtb.connector.ex,
  org.titou10.jtb.connector.transport,
